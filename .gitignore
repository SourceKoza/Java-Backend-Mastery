```gitignore
# ==========================
# Maven
# ==========================

# Build output (all modules)
**/target/

# Keep Maven Wrapper JAR
!**/.mvn/wrapper/maven-wrapper.jar

# ==========================
# Spring Boot
# ==========================

**/HELP.md

# ==========================
# IntelliJ IDEA
# ==========================

**/.idea/
*.iml
*.iws
*.ipr

# ==========================
# Eclipse / STS
# ==========================

.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# ==========================
# NetBeans
# ==========================

**/nbproject/private/
**/nbbuild/
**/dist/
**/nbdist/
**/.nb-gradle/
**/build/

# ==========================
# VS Code
# ==========================

**/.vscode/

# ==========================
# macOS
# ==========================

.DS_Store

# ==========================
# Logs
# ==========================

*.log
```
